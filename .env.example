# Copy this file to .env and fill in the real values before starting the bot.

# Discord bot token used to authenticate the bot with Discord.
DISCORD_TOKEN=your-discord-bot-token

# Optional path to a private config file. Leave unset to use config.json in the repo root.
CONFIG_PATH=

# Database connection string used by Tortoise ORM.
# Local development example:
PG_URI=sqlite://db.sqlite3

# Production PostgreSQL example:
# PG_URI=postgres://username:password@host:5432/database_name

# Optional Sentry error reporting DSN.
SENTRY_DSN=